[Unit]
Description=Phoniebox MQTT Client Service
Wants=network-online.target
After=network-online.target mpd.service

[Service]
User=pi
Group=pi
Restart=always
RestartSec=10
WorkingDirectory=/home/pi/RPi-Jukebox-RFID
ExecStart=/usr/bin/python3 -u /home/pi/RPi-Jukebox-RFID/components/smart-home-automation/MQTT-protocol/daemon_mqtt_client.py

[Install]
WantedBy=multi-user.target
